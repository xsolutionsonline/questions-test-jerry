{
  "info": {
    "name": "Client API",
    "description": "API-first Client API - GET/POST/DELETE clients",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Get Clients",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/clients",
          "host": ["{{baseUrl}}"],
          "path": ["api", "clients"]
        }
      },
      "response": []
    },
    {
      "name": "Create Client",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Juan\",\n  \"lastName\": \"Perez\",\n  \"surname\": \"Gomez\",\n  \"phone\": \"3001234567\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/client",
          "host": ["{{baseUrl}}"],
          "path": ["api", "client"]
        }
      },
      "response": []
    },
    {
      "name": "Delete Client",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/clients/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "clients", "1"]
        }
      },
      "response": []
    }
  ]
}
